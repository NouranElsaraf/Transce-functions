{
  "name": "transcendental-quest",
  "private": true,
  "version": "1.1.0",
  "description": "An interactive, discovery-first game that teaches the intuition behind transcendental functions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run docs && vite build",
    "check:unpublished": "node scripts/check-no-unpublished.mjs",
    "build:review": "npm run docs && VITE_REVIEW_PREVIEW=1 vite build --outDir dist-review",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "studio": "node scripts/studio.mjs",
    "studio:server": "node server/index.mjs",
    "lessons:import": "node scripts/import-lesson.mjs",
    "lessons:demo": "node scripts/build-demo-lesson.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
